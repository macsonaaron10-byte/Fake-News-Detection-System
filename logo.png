><span class="token token" style="color: rgb(204, 123, 244);">import</span><span> MongoClient
</span></span><span>
</span><span><span>client </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> MongoClient</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(155, 233, 99);">"mongodb+srv://youruser:TestPass123@cluster0.xxxxx.mongodb.net/?retryWrites=true&amp;w=majority"</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>
</span></span><span><span>db </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> client</span><span class="token token" style="color: rgb(211, 215, 222);">[</span><span class="token token" style="color: rgb(155, 233, 99);">"your_db_name"</span><span class="token token" style="color: rgb(211, 215, 222);">]</span><span>
</span></span><span><span>collection </span><span class="token token" style="color: rgb(234, 236, 240);">=</span><span> db</span><span class="token token" style="color: rgb(211, 215, 222);">[</span><span class="token token" style="color: rgb(155, 233, 99);">"your_collection"</span><span class="token token" style="color: rgb(211, 215, 222);">]</span><span>
</span></span><span>
